

# Task 2 – Exploratory Data Analysis (EDA)

## Titanic Dataset

### Introduction

In this task, I performed Exploratory Data Analysis (EDA) on the Titanic dataset. The main purpose of EDA is to understand the data before using it for further analysis or machine learning.

I used Python with Pandas, Matplotlib and Seaborn to check the data, find missing values, calculate basic statistics and create different graphs.

---

## Python Code

```python
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# Load the Titanic dataset
df = pd.read_csv("Titanic-Dataset (2).csv")

# Display first 5 rows
print("First 5 rows of the dataset:")
print(df.head())

# Display number of rows and columns
print("\nShape of the dataset:")
print(df.shape)

# Display column names
print("\nColumn names:")
print(df.columns)

# Display basic information
print("\nInformation about the dataset:")
df.info()

# Display statistical information
print("\nStatistical summary:")
print(df.describe())

# Check missing values
print("\nMissing values:")
print(df.isnull().sum())

# Check duplicate rows
print("\nNumber of duplicate rows:")
print(df.duplicated().sum())


# ------------------------------------------------
# Mean, Median and Standard Deviation
# ------------------------------------------------

print("\nMean:")
print(df.select_dtypes(include="number").mean())

print("\nMedian:")
print(df.select_dtypes(include="number").median())

print("\nStandard Deviation:")
print(df.select_dtypes(include="number").std())


# ------------------------------------------------
# Histogram of Age
# ------------------------------------------------

plt.figure(figsize=(8, 5))

sns.histplot(df["Age"].dropna(), bins=30, kde=True)

plt.title("Age Distribution")
plt.xlabel("Age")
plt.ylabel("Number of Passengers")

plt.show()


# ------------------------------------------------
# Histogram of Fare
# ------------------------------------------------

plt.figure(figsize=(8, 5))

sns.histplot(df["Fare"], bins=30, kde=True)

plt.title("Fare Distribution")
plt.xlabel("Fare")
plt.ylabel("Number of Passengers")

plt.show()


# ------------------------------------------------
# Boxplot of Age
# ------------------------------------------------

plt.figure(figsize=(8, 5))

sns.boxplot(x=df["Age"])

plt.title("Age Boxplot")
plt.xlabel("Age")

plt.show()


# ------------------------------------------------
# Boxplot of Fare
# ------------------------------------------------

plt.figure(figsize=(8, 5))

sns.boxplot(x=df["Fare"])

plt.title("Fare Boxplot")
plt.xlabel("Fare")

plt.show()


# ------------------------------------------------
# Survival Count
# ------------------------------------------------

plt.figure(figsize=(6, 5))

sns.countplot(x="Survived", data=df)

plt.title("Survival Count")
plt.xlabel("Survived (0 = No, 1 = Yes)")
plt.ylabel("Number of Passengers")

plt.show()


# ------------------------------------------------
# Survival according to Gender
# ------------------------------------------------

plt.figure(figsize=(7, 5))

sns.countplot(x="Sex", hue="Survived", data=df)

plt.title("Survival according to Gender")
plt.xlabel("Gender")
plt.ylabel("Number of Passengers")

plt.show()


# ------------------------------------------------
# Survival according to Passenger Class
# ------------------------------------------------

plt.figure(figsize=(7, 5))

sns.countplot(x="Pclass", hue="Survived", data=df)

plt.title("Survival according to Passenger Class")
plt.xlabel("Passenger Class")
plt.ylabel("Number of Passengers")

plt.show()


# ------------------------------------------------
# Correlation Matrix
# ------------------------------------------------

numeric_data = df.select_dtypes(include="number")

correlation = numeric_data.corr()

print("\nCorrelation Matrix:")
print(correlation)

plt.figure(figsize=(9, 7))

sns.heatmap(
    correlation,
    annot=True,
    fmt=".2f",
    cmap="coolwarm"
)

plt.title("Correlation Matrix")

plt.show()


# ------------------------------------------------
# Pairplot
# ------------------------------------------------

data_for_pairplot = df[
    ["Survived", "Pclass", "Age", "SibSp", "Parch", "Fare"]
].dropna()

sns.pairplot(
    data_for_pairplot,
    hue="Survived"
)

plt.show()


# ------------------------------------------------
# Survival Rate according to Gender
# ------------------------------------------------

gender_rate = df.groupby("Sex")["Survived"].mean()

print("\nSurvival rate according to gender:")
print(gender_rate)


# ------------------------------------------------
# Survival Rate according to Class
# ------------------------------------------------

class_rate = df.groupby("Pclass")["Survived"].mean()

print("\nSurvival rate according to passenger class:")
print(class_rate)


# ------------------------------------------------
# Survival Rate according to Embarked Port
# ------------------------------------------------

embarked_rate = df.groupby("Embarked")["Survived"].mean()

print("\nSurvival rate according to embarked port:")
print(embarked_rate)
```

