# Task 1: Data Cleaning & Preprocessing

This version follows the internship PDF: explore the dataset, handle missing values, encode categorical features, standardize numerical features, and visualize/remove outliers. 

## 1. Python Code

Save this as **`task1_preprocessing.py`**.

```python
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from sklearn.preprocessing import StandardScaler


# Load the Titanic dataset
df = pd.read_csv("Titanic-Dataset.csv")

print("First 5 rows of the dataset:")
print(df.head())

print("\nShape of the dataset:")
print(df.shape)


# Check the information of the dataset
print("\nDataset information:")
df.info()


# Check missing values
print("\nMissing values:")
print(df.isnull().sum())


# Basic statistics
print("\nBasic statistics:")
print(df.describe())


# -----------------------------------------
# Handling Missing Values
# -----------------------------------------

# Cabin has many missing values, so I removed this column
df = df.drop("Cabin", axis=1)

# Fill missing Age values with median
df["Age"] = df["Age"].fillna(df["Age"].median())

# Fill missing Embarked values with mode
df["Embarked"] = df["Embarked"].fillna(df["Embarked"].mode()[0])


print("\nMissing values after handling:")
print(df.isnull().sum())


# -----------------------------------------
# Encoding Categorical Data
# -----------------------------------------

# Convert Sex into numbers
df["Sex"] = df["Sex"].map({
    "male": 0,
    "female": 1
})

# Convert Embarked into separate columns
df = pd.get_dummies(df, columns=["Embarked"], dtype=int)


# Remove Name and Ticket for this basic ML preprocessing
df = df.drop(["Name", "Ticket"], axis=1)


print("\nDataset after encoding:")
print(df.head())


# -----------------------------------------
# Detecting Outliers
# -----------------------------------------

# Boxplot for Age
plt.figure(figsize=(7, 4))
sns.boxplot(x=df["Age"])
plt.title("Age Boxplot")
plt.show()


# Boxplot for Fare
plt.figure(figsize=(7, 4))
sns.boxplot(x=df["Fare"])
plt.title("Fare Boxplot")
plt.show()


# -----------------------------------------
# Removing Outliers using IQR
# -----------------------------------------

for column in ["Age", "Fare"]:

    Q1 = df[column].quantile(0.25)
    Q3 = df[column].quantile(0.75)

    IQR = Q3 - Q1

    lower_limit = Q1 - 1.5 * IQR
    upper_limit = Q3 + 1.5 * IQR

    df = df[
        (df[column] >= lower_limit) &
        (df[column] <= upper_limit)
    ]


print("\nShape after removing outliers:")
print(df.shape)


# -----------------------------------------
# Standardization
# -----------------------------------------

columns_to_scale = ["Age", "Fare", "SibSp", "Parch"]

scaler = StandardScaler()

df[columns_to_scale] = scaler.fit_transform(
    df[columns_to_scale]
)


print("\nDataset after standardization:")
print(df.head())


# -----------------------------------------
# Final Check
# -----------------------------------------

print("\nFinal missing values:")
print(df.isnull().sum())

print("\nFinal dataset shape:")
print(df.shape)


# Save the final dataset
df.to_csv("Titanic-final-preprocessed.csv", index=False)

print("\nTask 1 completed successfully!")
```

